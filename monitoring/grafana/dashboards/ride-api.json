          "custom": {"fillOpacity": 80, "lineWidth": 0}
        },
        "overrides": []
      },
      "options": {"showValue": "never", "mergeValues": true, "rowHeight": 0.8, "alignValue": "left", "legend": {"showLegend": false}, "tooltip": {"mode": "single", "sort": "none"}}
    },
    {
      "id": 26,
      "type": "table",
      "title": "Firing alerts",
