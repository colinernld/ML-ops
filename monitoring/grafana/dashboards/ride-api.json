{
  "uid": "ride-api",
  "title": "Ride classifier - monitoring",
  "description": "Production monitoring of the ride classification API in 4 layers: infrastructure, service, input data, model output. Provisioned from monitoring/grafana/dashboards/ride-api.json (edit it in git).",
  "tags": ["mlops", "ride-classifier"],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "templating": {"list": []},
  "annotations": {"list": []},
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API",
      "description": "Prometheus can scrape the API's /metrics endpoint.",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max(up{job=\"ride-api\"})", "instant": true, "range": false}
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no data",
          "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Model version served",
      "description": "Registry version of ride-classifier the API serves (models:/ride-classifier@production). Changes after a promotion + reload.",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max by (version) (model_info)", "legendFormat": "v{{version}}", "instant": true, "range": false}
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no model",
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}
        },
        "overrides": []
      },
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "name", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Predictions (time range)",
      "description": "Rides scored during the selected time range.",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(increase(predictions_total[$__range]))", "instant": true, "range": false}
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "short",
          "decimals": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}
        },
        "overrides": []
      },
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Prediction errors (5xx, 5 min)",
      "description": "Share of /predict requests that failed on the server side (alert ApiHighErrorRate above 5 %).",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "(sum(rate(api_requests_total{path=~\"/predict.*\", status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(api_requests_total{path=~\"/predict.*\"}[5m])), 1e-9)", "instant": true, "range": false}
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no traffic",
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.05}]}
        },
        "overrides": []
      },
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Prediction latency p95 (5 min)",
      "description": "95 % of predictions answer faster than this (alert ApiSlowPredictions above 2 s).",
      "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum by (le) (rate(api_request_duration_seconds_bucket{path=~\"/predict.*\"}[5m])))", "instant": true, "range": false}
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no traffic",
          "unit": "s",
          "decimals": 2,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 2}]}
        },
        "overrides": []
      },
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Firing alerts",
      "description": "Alert rules currently firing (monitoring/prometheus/alerts.yml). Details in the table at the bottom.",
      "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)", "instant": true, "range": false}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 100,
      "type": "row",
      "title": "1 · Infrastructure: are the services up, and how much do they use?",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 4, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Health checks",
      "description": "Each service's health check, called every 15 s by the blackbox exporter (api = GET /ready: a model is loaded).",
      "gridPos": {"x": 0, "y": 5, "w": 12, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max by (service) (probe_success)", "legendFormat": "{{service}}", "instant": true, "range": false}
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no data",
          "mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "justifyMode": "center", "orientation": "vertical", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Health check response time",
      "gridPos": {"x": 12, "y": 5, "w": 12, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max by (service) (probe_duration_seconds)", "legendFormat": "{{service}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"fillOpacity": 0, "lineWidth": 1}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "API CPU (cores used)",
      "gridPos": {"x": 0, "y": 10, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (instance) (rate(process_cpu_seconds_total{job=\"ride-api\"}[$__rate_interval]))", "legendFormat": "{{instance}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"fillOpacity": 10, "lineWidth": 1}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "API memory (limit 1.5 GiB on Kubernetes)",
      "description": "Resident memory of the API process. The red line is the Kubernetes memory limit (k8s/api.yaml): above it the pod is OOMKilled.",
      "gridPos": {"x": 8, "y": 10, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "process_resident_memory_bytes{job=\"ride-api\"}", "legendFormat": "{{instance}}"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {"fillOpacity": 10, "lineWidth": 1, "thresholdsStyle": {"mode": "line"}},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1610612736}]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 11,
      "type": "stat",
      "title": "API uptime",
      "description": "Time since the (oldest) API process started.",
      "gridPos": {"x": 16, "y": 10, "w": 4, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "time() - min(process_start_time_seconds{job=\"ride-api\"})", "instant": true, "range": false}
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "down",
          "unit": "s",
          "decimals": 1,
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}
        },
        "overrides": []
      },
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 12,
      "type": "stat",
      "title": "API restarts (time range)",
      "description": "Restarts of the API process (crash, OOMKilled, liveness probe). A rolling update creates new pods and is not counted.",
      "gridPos": {"x": 20, "y": 10, "w": 4, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(changes(process_start_time_seconds{job=\"ride-api\"}[$__range])) or vector(0)", "instant": true, "range": false}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}
        },
        "overrides": []
      },
      "options": {"colorMode": "value", "graphMode": "none", "textMode": "value", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 101,
      "type": "row",
      "title": "2 · Service: does the API answer, fast and without errors?",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 17, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Requests per second (by endpoint and status)",
      "description": "Includes the Kubernetes probes on /health and /ready.",
      "gridPos": {"x": 0, "y": 18, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (path, status) (rate(api_requests_total[$__rate_interval]))", "legendFormat": "{{path}} {{status}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "custom": {"fillOpacity": 10, "lineWidth": 1}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Prediction latency (/predict, /predict/file)",
      "gridPos": {"x": 8, "y": 18, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.5, sum by (le) (rate(api_request_duration_seconds_bucket{path=~\"/predict.*\"}[$__rate_interval])))", "legendFormat": "p50"},
        {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, sum by (le) (rate(api_request_duration_seconds_bucket{path=~\"/predict.*\"}[$__rate_interval])))", "legendFormat": "p95"},
        {"refId": "C", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.99, sum by (le) (rate(api_request_duration_seconds_bucket{path=~\"/predict.*\"}[$__rate_interval])))", "legendFormat": "p99"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {"fillOpacity": 0, "lineWidth": 1, "thresholdsStyle": {"mode": "dashed"}},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 2}]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Failed prediction requests (share)",
      "description": "5xx = the API could not answer (often: no model loaded). 4xx = the ride was rejected by validation (bad input, see the input data row).",
      "gridPos": {"x": 16, "y": 18, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "(sum(rate(api_requests_total{path=~\"/predict.*\", status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(api_requests_total{path=~\"/predict.*\"}[$__rate_interval]))", "legendFormat": "server errors (5xx)"},
        {"refId": "B", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "(sum(rate(api_requests_total{path=~\"/predict.*\", status=~\"4..\"}[$__rate_interval])) or vector(0)) / sum(rate(api_requests_total{path=~\"/predict.*\"}[$__rate_interval]))", "legendFormat": "rejected rides (4xx)"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"fillOpacity": 10, "lineWidth": 1}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 102,
      "type": "row",
      "title": "3 · Input data: do the rides still look like the training data? (input drift)",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 26, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Mean acceleration |a| per ride",
      "description": "Gravity included: ≈ 9.5 m/s² on the training rides. Green band = expected (alert AccelerationDrift outside 8 – 11). ≈ 1 means the client sends g instead of m/s².",
      "gridPos": {"x": 0, "y": 27, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(ride_acc_magnitude_mean_sum[$__rate_interval])) / sum(rate(ride_acc_magnitude_mean_count[$__rate_interval]))", "legendFormat": "mean |a| of the rides scored"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: m/s²",
          "decimals": 2,
          "custom": {"fillOpacity": 0, "lineWidth": 2, "thresholdsStyle": {"mode": "line+area"}},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 8}, {"color": "red", "value": 11}]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Mean rotation |r| per ride",
      "description": "Training rides: 16 °/s (Safe) to 40 °/s (Reckless). Green band = expected (alert RotationDrift outside 3 – 35 °/s).",
      "gridPos": {"x": 8, "y": 27, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(ride_rot_magnitude_mean_sum[$__rate_interval])) / sum(rate(ride_rot_magnitude_mean_count[$__rate_interval]))", "legendFormat": "mean |r| of the rides scored"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: °/s",
          "decimals": 1,
          "custom": {"fillOpacity": 0, "lineWidth": 2, "thresholdsStyle": {"mode": "line+area"}},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 3}, {"color": "red", "value": 35}]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Rejected rides by reason",
      "description": "validation = the ride breaks a data rule (length, missing values, physical range); bad_file = unreadable CSV; file_too_large; model_unavailable = no model loaded.",
      "gridPos": {"x": 16, "y": 27, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (reason) (rate(prediction_errors_total[$__rate_interval]))", "legendFormat": "{{reason}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "custom": {"fillOpacity": 20, "lineWidth": 1}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Mean ride length",
      "description": "Training rides last 3 – 8 minutes (alert ShortRides under 1 minute).",
      "gridPos": {"x": 0, "y": 35, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(ride_samples_sum[$__rate_interval])) / sum(rate(ride_samples_count[$__rate_interval])) / 600", "legendFormat": "mean length of the rides scored"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "min": 0,
          "decimals": 1,
          "custom": {"fillOpacity": 0, "lineWidth": 2, "thresholdsStyle": {"mode": "line+area"}},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Missing sensor values (share of rows)",
      "description": "Training data: 0.7 % of rows (alert MissingValuesDrift above 5 %; rides above 20 % are rejected).",
      "gridPos": {"x": 8, "y": 35, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(ride_missing_ratio_sum[$__rate_interval])) / sum(rate(ride_missing_ratio_count[$__rate_interval]))", "legendFormat": "missing values in the rides scored"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "decimals": 1,
          "custom": {"fillOpacity": 0, "lineWidth": 2, "thresholdsStyle": {"mode": "line+area"}},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.05}]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 21,
      "type": "heatmap",
      "title": "Distribution of the mean rotation per ride",
      "description": "How many rides fall in each |r| bucket over time: a drift shows as the colour moving up or down.",
      "gridPos": {"x": 16, "y": 35, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (le) (increase(ride_rot_magnitude_mean_bucket[$__rate_interval]))", "legendFormat": "{{le}}", "format": "heatmap"}
      ],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {"mode": "scheme", "scheme": "Oranges", "exponent": 0.5, "steps": 64, "reverse": false},
        "yAxis": {"axisPlacement": "left", "unit": "suffix: °/s"},
        "rowsFrame": {"layout": "auto"},
        "legend": {"show": true},
        "tooltip": {"mode": "single", "yHistogram": false},
        "showValue": "never"
      }
    },
    {
      "id": 103,
      "type": "row",
      "title": "4 · Model: what does it predict, and how sure is it? (output drift)",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 43, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 22,
      "type": "piechart",
      "title": "Predicted classes (time range)",
      "description": "Training data: 83 % Safe, 8 % Safe overall, 4 % Bad weather, 4 % Tandem, 1 % Reckless.",
      "gridPos": {"x": 0, "y": 44, "w": 8, "h": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (label) (increase(predictions_total[$__range]))", "legendFormat": "{{label}}", "instant": true, "range": false}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
      "options": {
        "pieType": "donut",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "legend": {"displayMode": "table", "placement": "right", "showLegend": true, "values": ["percent", "value"]},
        "tooltip": {"mode": "single", "sort": "none"}
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Share of each predicted class",
      "description": "Expected ≈ 83 % Safe (alert PredictionDistributionDrift outside 50 – 97 %).",
      "gridPos": {"x": 8, "y": 44, "w": 8, "h": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (label) (rate(predictions_total[$__rate_interval])) / on() group_left sum(rate(predictions_total[$__rate_interval]))", "legendFormat": "{{label}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"fillOpacity": 60, "lineWidth": 1, "stacking": {"mode": "normal", "group": "A"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Mean confidence of the predictions",
      "description": "Probability of the predicted class, averaged over the rides scored (alert LowPredictionConfidence under 35 %; 20 % = random among 5 classes).",
      "gridPos": {"x": 16, "y": 44, "w": 8, "h": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(prediction_confidence_sum[$__rate_interval])) / sum(rate(prediction_confidence_count[$__rate_interval]))", "legendFormat": "mean confidence"}
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {"fillOpacity": 0, "lineWidth": 2, "thresholdsStyle": {"mode": "line+area"}},
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.35}]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 25,
      "type": "state-timeline",
      "title": "Model version served over time",
      "description": "One line per registry version: shows when a promotion + reload (or a rollback) happened.",
      "gridPos": {"x": 0, "y": 53, "w": 12, "h": 6},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "max by (version) (model_info)", "legendFormat": "v{{version}}"}
      ],
