# Copy to .env (git-ignored) and change the passwords:  cp .env.example .env
# Use letters and digits only: the Postgres password ends up in a connection URL.

# MinIO (S3-compatible storage for MLflow artifacts: models, reports)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
MLFLOW_BUCKET=mlflow

# Postgres (MLflow metadata: experiments, runs, params, metrics, model registry)
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=changemepostgres
POSTGRES_DB=mlflow

# Host names MLflow accepts requests for (it rejects others). "mlflow" = other containers in
# this Compose project calling http://mlflow:5000. Add your Kubernetes Service name if it differs.
MLFLOW_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,mlflow,mlflow:*

# Ports on your machine. MLflow is NOT on 5000 because macOS uses 5000 for AirPlay Receiver.
MLFLOW_PORT=5050
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Training pipeline (Airflow, optional: docker compose --profile airflow up -d)
AIRFLOW_PORT=8080
# API that the pipeline reloads after a promotion (default: uvicorn on your laptop)
PIPELINE_API_URL=http://host.docker.internal:8000
# Same value as the API's RELOAD_TOKEN (empty = no token, dev only)
RELOAD_TOKEN=
